# Public origin of the site, used for the sitemap, canonical URLs and Open Graph.
SITE_URL="https://example.org"

# Hosted form service that receives Apply / Contact submissions (static site — no server).
# Create a form at e.g. https://formspree.io and paste its endpoint here, then rebuild.
# Leave empty to show visitors the contact details instead of an online form.
NEXT_PUBLIC_FORM_ENDPOINT=""
