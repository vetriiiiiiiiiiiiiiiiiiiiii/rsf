# PostgreSQL connection string (direct TCP connection).
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/rs_foundation?sslmode=require"
# Maximum connections per server instance.
DATABASE_POOL_MAX="10"
# 32+ random bytes, used to sign form tokens and hash client identifiers.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=""
# Public origin of the site, used for sitemap, canonical URLs and Open Graph.
SITE_URL="https://example.org"
# Directory (outside /public) where uploaded images and documents are stored.
UPLOAD_DIR="./storage/uploads"
# First administrator, created by `npm run admin:create`. Remove from the environment afterwards.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
