generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum AdminRole {
  ADMIN
  EDITOR
}

// ─── Administration ────────────────────────────────────────────────

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(EDITOR)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  auditLogs    AuditLog[]
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  userAgent String?

  @@index([userId])
}

model AuditLog {
  id        String     @id @default(cuid())
  userId    String?
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  summary   String?
  createdAt DateTime   @default(now())

  @@index([createdAt])
}

model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

// ─── Media ─────────────────────────────────────────────────────────

enum MediaKind {
  IMAGE
  DOCUMENT
}

model MediaAsset {
  id           String    @id @default(cuid())
  storageKey   String    @unique
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  alt          String    @default("")
  kind         MediaKind
  // Private assets (pitch decks) are only served to authenticated administrators.
  isPublic     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  startups     Startup[]
  events       Event[]
  news         NewsPost[]
  people       Person[]
  partners     Partner[]
  applications Application[]
}

// ─── Public content ────────────────────────────────────────────────

model StartupCategory {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  order    Int       @default(0)
  startups Startup[]
}

model Startup {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  tagline     String
  description String
  founders    String?
  stage       String?
  foundedYear Int?
  location    String?
  website     String?
  featured    Boolean          @default(false)
  status      PublishStatus    @default(DRAFT)
  order       Int              @default(0)
  categoryId  String?
  category    StartupCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  imageId     String?
  image       MediaAsset?      @relation(fields: [imageId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, featured])
}

model Program {
  id                    String        @id @default(cuid())
  slug                  String        @unique
  name                  String
  summary               String
  description           String
  audience              String?
  duration              String?
  format                String?
  illustration          String        @default("validation")
  // True while the programme is a proposed category awaiting confirmation by the foundation.
  provisional           Boolean       @default(true)
  acceptingApplications Boolean       @default(false)
  status                PublishStatus @default(DRAFT)
  order                 Int           @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

enum EventCategory {
  WORKSHOP
  FOUNDER_SESSION
  DEMO_DAY
  DEADLINE
  TALK
  OTHER
}

model Event {
  id               String              @id @default(cuid())
  slug             String              @unique
  title            String
  category         EventCategory       @default(WORKSHOP)
  summary          String
  body             String
  startsAt         DateTime
  endsAt           DateTime?
  location         String?
  registrationUrl  String?
  registrationOpen Boolean             @default(false)
  capacity         Int?
  status           PublishStatus       @default(DRAFT)
  imageId          String?
  image            MediaAsset?         @relation(fields: [imageId], references: [id], onDelete: SetNull)
  registrations    EventRegistration[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status, startsAt])
}

model EventRegistration {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name         String
  email        String
  phone        String?
  organisation String?
  createdAt    DateTime @default(now())

  @@unique([eventId, email])
}

model NewsPost {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String
  body        String
  publishedAt DateTime      @default(now())
  status      PublishStatus @default(DRAFT)
  imageId     String?
  image       MediaAsset?   @relation(fields: [imageId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, publishedAt])
}

enum PersonKind {
  LEADERSHIP
  MENTOR
}

model Person {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  role        String
  kind        PersonKind    @default(MENTOR)
  bio         String?
  expertise   String?
  linkedinUrl String?
  websiteUrl  String?
  status      PublishStatus @default(DRAFT)
  order       Int           @default(0)
  imageId     String?
  image       MediaAsset?   @relation(fields: [imageId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum PartnerKind {
  INDUSTRY
  MENTORSHIP
  INVESTOR
  INSTITUTIONAL
}

model Partner {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  kind        PartnerKind   @default(INSTITUTIONAL)
  description String?
  url         String?
  status      PublishStatus @default(DRAFT)
  order       Int           @default(0)
  logoId      String?
  logo        MediaAsset?   @relation(fields: [logoId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// Key–value store for editable homepage copy, contact details and social links.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Submissions ───────────────────────────────────────────────────

enum InquiryType {
  GENERAL
  FOUNDER
  STUDENT
  MENTOR
  INVESTOR
  INDUSTRY
  INSTITUTIONAL
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

model Inquiry {
  id           String        @id @default(cuid())
  type         InquiryType   @default(GENERAL)
  name         String
  email        String
  phone        String?
  organisation String?
  message      String
  status       InquiryStatus @default(NEW)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, createdAt])
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model Application {
  id            String            @id @default(cuid())
  reference     String            @unique
  founderName   String
  email         String
  phone         String
  institution   String?
  city          String?
  ventureName   String
  sector        String
  stage         String
  programSlug   String?
  problem       String
  solution      String
  teamSize      Int
  team          String
  website       String?
  support       String
  status        ApplicationStatus @default(SUBMITTED)
  internalNotes String?
  consentAt     DateTime
  pitchDeckId   String?
  pitchDeck     MediaAsset?       @relation(fields: [pitchDeckId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status, createdAt])
}
